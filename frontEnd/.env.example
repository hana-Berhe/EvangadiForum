# Copy this file to `.env`. It is the address of the backend API.
# Local:    /api   (vite.config.js forwards it to http://localhost:5000)
# Deployed: /api   (vercel.json forwards it to the Render backend)
# Using the same address keeps the httpOnly login cookie first-party.
# A trailing slash or a missing "/api" is fixed automatically (src/api/config.js).
VITE_API_BASE_URL=/api
